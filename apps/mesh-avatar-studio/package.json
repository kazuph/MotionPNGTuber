{
  "name": "mesh-avatar-studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "screenshots": "node tools/capture-readme-screenshots.mjs",
    "test": "vitest run",
    "lint": "eslint src tests e2e tools/*.mjs",
    "build": "tsc --noEmit && vite build",
    "e2e": "playwright test",
    "validate-rig": "node --experimental-strip-types tools/validate-rig.mjs",
    "render-poses": "node --experimental-strip-types tools/render-poses.mjs"
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@playwright/test": "^1.55.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "eslint": "^9.0.0",
    "globals": "^16.0.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "8.70.1",
    "vite": "^7.0.0",
    "vitest": "^3.2.0",
    "pngjs": "^7.0.0",
    "@types/pngjs": "^6.0.0"
  },
  "overrides": {
    "@typescript-eslint/project-service": "8.70.1",
    "@typescript-eslint/tsconfig-utils": "8.70.1",
    "@typescript-eslint/scope-manager": "8.70.1",
    "@typescript-eslint/type-utils": "8.70.1",
    "@typescript-eslint/types": "8.70.1",
    "@typescript-eslint/parser": "8.70.1",
    "@typescript-eslint/eslint-plugin": "8.70.1",
    "@typescript-eslint/typescript-estree": "8.70.1",
    "@typescript-eslint/utils": "8.70.1",
    "@typescript-eslint/visitor-keys": "8.70.1",
    "browserslist": "4.29.1",
    "electron-to-chromium": "1.5.439",
    "caniuse-lite": "1.0.30001812",
    "typescript-eslint": "8.70.1",
    "ignore": "7.0.10",
    "baseline-browser-mapping": "2.11.26"
  }
}
